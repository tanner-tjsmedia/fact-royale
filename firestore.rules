rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who counts as admin ────────────────────────────────
    // One definition, imported everywhere. This string used to be written
    // out in five separate rules, which is five places to miss when the
    // address changes and five chances for them to drift apart.
    //
    // Deliberately NOT checking email_verified here. Adding it would be a
    // real hardening, but if the admin account was created without
    // verification it locks the admin out of their own console. Decide that
    // one on purpose, not as a side effect of this fix.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'tanner@tjs16media.com';
    }

    // ── Daily leaderboard scores (public read, server write only) ──
    //
    // NO CLIENT MAY WRITE A SCORE. Not even its own, not even a valid-looking
    // one. The submitQuiz Cloud Function grades against quizKeys/ and writes
    // the row through the Admin SDK, which bypasses these rules entirely.
    //
    // This closes the hole that survived every earlier version. The old rule
    // validated the SHAPE of a score - right uid, sane range, correct doc id
    // - and shape was all it could ever check. A signed-in player could post
    // a flawless 12/12 without answering a question and no rule could tell.
    // Rules cannot regrade a quiz; only a server that holds the answer key
    // can, and no client holds it now.
    //
    // Write-once is enforced in the function's transaction as well, so two
    // submissions racing cannot both land.
    match /scores/{scoreId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Attempt records: the commit half of commit-then-reveal ──
    //
    // attempts/{uid}_{date} holds each choice a player committed, with the
    // instant they committed it. commitAnswer writes it through the Admin
    // SDK before it reveals anything, and refuses to regrade a question it
    // already holds - which is what stops a caller walking all four options
    // to find the right one.
    //
    // No client touches this in either direction. If a player could read it
    // they would learn nothing (it holds their own guesses, not the key), but
    // if a player could WRITE it they could rewrite history and then call
    // submitQuiz, which grades exactly this document. So: closed.
    //
    // Admin read is for forensics. A row of twelve commits three seconds
    // apart is a bot; the timestamps are the only place that shows.
    match /attempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── User profiles ──────────────────────────────────────
    // Admin gets read across the whole collection. The admin dashboard
    // counts registered users, actives, streaks and new signups, all of
    // which need collection('users').get() rather than a keyed lookup.
    //
    // Read only. Admin has no write access to user documents: nothing in
    // the console edits a profile, so granting it would widen the blast
    // radius of a compromised admin session for no feature.
    match /users/{userId} {
      allow read: if isAdmin()
                  || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null
                   && request.auth.uid == userId;

      // Mastery history snapshots
      match /masteryHistory/{entryId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Per-play quiz history (archive + daily)
      // Each doc keyed by date string: YYYY-MM-DD
      match /quizHistory/{date} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // ── Quiz content: prompts and options only ────────────
    // Readable ONLY once publishAt has passed. request.time is the server's
    // clock, so changing a device clock does nothing. This is the guarantee a
    // static file host cannot give: today, questions/2026-09-15.json is
    // fetchable by anyone three weeks early.
    //
    // The admin override exists for the live play area, which needs the whole
    // corpus regardless of date.
    //
    // Nothing reads this collection yet. See docs/SECURE-QUESTION-DB.md.
    match /quizzes/{dateKey} {
      allow read: if resource.data.publishAt <= request.time || isAdmin();
      allow write: if false;   // Admin SDK only, via tools/migrate-to-firestore.js
    }

    // ── Answer keys: never readable by any client ─────────
    // Answers live apart from prompts so they can be withheld independently.
    // Phase 2 still grades client-side; phase 3 moves grading to a Cloud
    // Function, at which point the client never holds an answer it has not
    // already committed a guess against.
    match /quizKeys/{dateKey} {
      allow read, write: if false;
    }

    // ── Question bank: the working store ──────────────────
    // This is where questions are AUTHORED and REVIEWED, keyed by their
    // permanent frq- id. It is not what players read -- that is quizzes/,
    // which is publishAt-gated and populated by an explicit publish step.
    //
    // Admin-only in both directions, and that is the whole security story
    // for this collection: it holds unpublished content and answers.
    //
    // When user-submitted question reports arrive later, they do NOT get
    // write access here. They write to a separate reports collection that
    // this bank never trusts directly.
    match /questionBank/{questionId} {
      allow read, write: if isAdmin();
    }

    // ── Fact bank: the working store for facts ────────────
    // Same shape and same reasoning as questionBank. Admin-only in both
    // directions because it holds unapproved claims, and a claim without
    // approvedBy is explicitly not fit to publish.
    //
    // Browser-writable by the admin on purpose. That is what lets approvals
    // happen from a laptop that is nowhere near the repo. The serving
    // collections below stay Admin-SDK-only, so nothing a browser session can
    // reach is what players actually read.
    //
    // History still lives in git: Firestore cannot diff or revert, so
    // facts-src/*.json remains the manuscript and the cloud copy is the
    // workbench. Export back to disk periodically.
    match /factBank/{factId} {
      allow read, write: if isAdmin();
    }

    // ── Studio metadata: the source registry mirror ───────
    // meta/sources is a copy of sources.json so the studio can show what a
    // citation establishes when running against the bank rather than files.
    // Admin-only: it is working data, not published evidence.
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Live game sessions (internal) ─────────────────────
    // Host console state for in-person and online live play. Admin-only for
    // now; opening this to player devices is a later decision and will need
    // its own rules rather than a loosening of these.
    match /liveGames/{gameId} {
      allow read, write: if isAdmin();
    }

    // ── Admin collection (server-side only) ───────────────
    match /admin/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }


    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.memberUids
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    // ── Anonymous play tracking ────────────────────────────
    // Write-only for players, readable by admin. The dashboard's play
    // counts and the 14-day trend query this collection by timestamp.
    //
    // This was read:false for everyone, which is why the admin console
    // returned permission-denied rather than empty tiles: the rule was
    // doing exactly what it said, just to the wrong audience.
    match /plays/{playId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /emailCaptures/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── Challenge records ──────────────────────────────────
    // Anyone with the cid can read.
    // Only authenticated users can create (prevents spam).
    // Anyone can write the result field exactly once (write-once guard).
    // Owner can update toName label, or delete if result not yet recorded.
    match /challenges/{cid} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if (resource.data.result == null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result']))
                    || (request.auth != null && request.auth.uid == resource.data.from
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toName']));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.from
                    && resource.data.result == null;
    }

  }
}
